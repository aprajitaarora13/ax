# The runner volume: an OCI image that holds only the static ax-task-runner.
#
# It is never run as a container. Agent Substrate mounts it read-only into
# every task container at /opt/ax (v1alpha1.RunnerMountPath), and the task's
# container command is /opt/ax/ax-task-runner. Task images therefore stay pure
# agent images (see harnesses/), and rolling out a new runner means bumping
# v1alpha1.RunnerVolumeImage, not rebuilding every agent image.
#
#   make push-runner-volume
FROM scratch
ARG TARGETARCH=amd64
COPY bin/linux_${TARGETARCH}/ax-task-runner /ax-task-runner
